<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1920, height=1080">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: #000;
      }
      body {
        font-family: "Inter", sans-serif;
      }
      code,
      pre,
      .monospace {
        font-family: "JetBrains Mono", monospace;
      }
      #sky {
        position: absolute;
        inset: 0;
        background: #87ceeb;
      }
      #circle {
        position: absolute;
        left: 120px;
        top: 50%;
        margin-top: -100px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: p;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-z7xn" id="root" data-composition-id="main" data-start="0" data-duration="12" data-width="1920" data-height="1080">
      <div data-hf-id="hf-12nj" id="sky" class="clip" data-start="0" data-duration="12" data-track-index="1"></div>
      <div data-hf-id="hf-cmen" id="circle" class="clip" data-start="0" data-duration="12" data-track-index="2"></div>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      const travelX = 1920 - 120 - 200 - 120;
      tl.fromTo("#circle", { x: 0 }, { x: travelX, duration: 5, ease: "none" }, 0);
      // holds at travelX from 5s to 7s (no tween needed)
      tl.to("#circle", { x: 0, duration: 5, ease: "none" }, 7);
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
